NODE_ENV=production
PORT=3000
APP_NAME=ServicePro
APP_VERSION=8.0.0-alpha.1
DEFAULT_TENANT_ID=SET_EXTERNALLY_TENANT_ID

DATA_STORE=postgres
DATABASE_URL=SET_EXTERNALLY_POSTGRESQL_CONNECTION_STRING
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_QUERY_TIMEOUT_MS=20000
POSTGRES_PASSWORD=SET_EXTERNALLY_DATABASE_PASSWORD
REDIS_URL=SET_EXTERNALLY_REDIS_CONNECTION_STRING

JWT_SECRET=SET_EXTERNALLY_64_PLUS_RANDOM_CHARACTERS
ACCESS_TOKEN_TTL_SECONDS=3600
PORTAL_TOKEN_SECRET=SET_EXTERNALLY_64_PLUS_RANDOM_CHARACTERS
PORTAL_TOKEN_TTL_SECONDS=3600

LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=https://SET_EXTERNALLY_APP_DOMAIN,https://SET_EXTERNALLY_PORTAL_DOMAIN
MAX_JSON_BODY_BYTES=1048576
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_MAX_REQUESTS=12
FEATURE_EMAIL_ENABLED=true
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=ServicePRO <noreply@example.com>
APP_BASE_URL=https://app.example.com
FEATURE_PAYMENTS_ENABLED=true
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
STRIPE_CURRENCY=usd
