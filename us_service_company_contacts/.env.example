# Application configuration
USER_AGENT=ServiceContactsBot/1.0 (+mailto:admin@example.com)
ADMIN_CONTACT_EMAIL=admin@example.com

# Database
DATABASE_URL=sqlite:///data/service_contacts.db

# Overpass API
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
OVERPASS_FALLBACK_ENDPOINTS=https://overpass.kumi.systems/api/interpreter,https://overpass.nchc.org.tw/api/interpreter
OVERPASS_TIMEOUT=60

# Rate limiting
HTTP_TIMEOUT=30
REQUESTS_PER_SECOND=0.5
MAX_WORKERS=5
MAX_PAGES_PER_DOMAIN=5
