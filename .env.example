NODE_ENV=development
PORT=3000
DEFAULT_TENANT_ID=tenant_demo
DATA_STORE=json
DATA_FILE=./data/servicepro-runtime.json
DATABASE_URL=postgresql://servicepro:development-only@localhost:5432/servicepro
DATABASE_SSL=false

JWT_SECRET=development-only-jwt-secret-never-use-in-production
ACCESS_TOKEN_TTL_SECONDS=3600
PORTAL_TOKEN_SECRET=development-only-portal-secret-never-use-in-production
PORTAL_TOKEN_TTL_SECONDS=3600

APP_NAME=ServicePro
APP_VERSION=8.0.0-alpha.1
LOG_LEVEL=info

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_JSON_BODY_BYTES=1048576
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_MAX_REQUESTS=12
PLATFORM_ADMIN_EMAILS=cphillips@aardvark-enterprises.net,admin1914@aardvark-enterprises.net,5189213@gmail.com
